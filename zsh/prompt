# Function to get the local IP address
function get_local_ip() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS: Use ifconfig to get the local IP address
    ifconfig | awk '/inet / && !/127.0.0.1/ {print $2}' | head -n 1
  elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    # Linux: Use hostname -I to get the local IP address
    hostname -I | awk '{print $1}'
  else
    # Fallback for unknown OS
    echo "N/A"
  fi
}

# Hostname and OS never change, so work them out once rather than every prompt
# (magenta for Linux, cyan for others e.g. macOS)
() {
  local os=$(uname -s)
  local color=cyan
  [[ "$os" == "Linux" ]] && color=magenta
  prompt_host="%{$fg[$color]%}$(hostname -s) (${os})%{$reset_color%}"
}

# Prompt definition
local smiley="%(?,%{$fg[green]%}☺%{$reset_color%},%{$fg[red]%}☹%{$reset_color%})"

PROMPT=$'
%{\e[0;37m%}%n %{\e[0;36m%}${prompt_host} $(get_local_ip) %{\e[0;33m%}%~
${smiley}  %{$reset_color%}'

RPROMPT='%{$fg[white]%} $("$DOTFILES/functions/git-cwd-info")%{$reset_color%}'

#$(~/.rvm/bin/rvm-prompt)
