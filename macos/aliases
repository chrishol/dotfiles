# macOS sections for the `?` help (see common/aliases)
function alias_list_os() {
  help_section "TASKS" \
    "tu" "cpu usage" "tm" "memory usage"
}

############################################################
## Rails
############################################################
alias rs="rails s"
alias bers="bundle exec rails server"
alias rc="rails c"
alias berc="bundle exec rails c"
alias bindev="bin/dev"
alias ru="unicorn -p 3000 -c ./config/unicorn.rb"
alias beru="bundle exec unicorn -p 3000 -c ./config/unicorn.rb"
alias rmig="rake db:migrate"
alias berdbm="bundle exec rails db:migrate"
alias fs="foreman start"
alias befs="bundle exec foreman start"

############################################################
## Task Management
############################################################
alias tu="top -o cpu"    #cpu
alias tm="top -o vsize"  #memory

############################################################
## Bundler
############################################################
alias b="bundle"
alias be="b exec"
alias bu="b update"

############################################################
## Heroku
############################################################

alias hrc="heroku run console"

############################################################
## RVM
############################################################
[[ -s "/usr/local/rvm/scripts/rvm" ]] && source "/usr/local/rvm/scripts/rvm" # Load RVM into a shell session *as a function*
