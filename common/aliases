alias gup="git pull --rebase --prune"

# Default branch from origin/HEAD, falling back to main or master
function git_default_branch() {
  local branch
  branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  if [[ -n "$branch" ]]; then
    echo "${branch#origin/}"
  elif git show-ref --verify --quiet refs/heads/main; then
    echo main
  else
    echo master
  fi
}

# Delete local branches merged into the default branch, then prune remotes
function gp() {
  local default_branch branches
  default_branch=$(git_default_branch)
  branches=$(git branch --merged "$default_branch" --format='%(refname:short)' \
    | grep -vx -e "$default_branch" -e "$(git branch --show-current)")

  if [[ -z "$branches" ]]; then
    echo "No branches to delete."
  else
    echo "$branches" | xargs -n 1 git branch -d
  fi

  git remote prune origin
}

alias gpp='gup && gp'

alias gcb="git branch --show-current"

function ggg() {
  git commit -v -m "$*"
}

function gpo() {
  if [ -z "$1" ]; then
    git push origin "$(git_default_branch)"
  else
    git push origin "$@"
  fi
}

alias gl="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ci)%Creset' --abbrev-commit --date=relative"
alias glst="gl --stat"
alias glsh="git shortlog -sn"

function gco {
  if [ -z "$1" ]; then
    git checkout "$(git_default_branch)"
  else
    git checkout "$@"
  fi
}

# Comedy productivity measure
function gdays() {
  git diff --shortstat "@{$1 days ago}"
}

function gph() {
  if [ -z "$1" ]; then
    git push heroku "$(git_default_branch)"
  else
    git push heroku "$@"
  fi
}

